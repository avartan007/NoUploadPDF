# Ignore local zip backups & distribution archives
*.zip
*.tar.gz
NoUploadPDF-Rails8.zip

# Rails temporary and runtime files
/tmp/*
!/tmp/.keep
/log/*
!/log/.keep
/storage/*
!/storage/.keep

# Environment variables & local secrets
.env
.env.*
!.env.example
/tmp/local_secret.txt

# macOS system files
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Node & package dependencies
/node_modules/
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*

# Test & E2E artifacts
/test-results/
/playwright-report/
/coverage/

# Local databases
/db/*.sqlite3
/db/*.sqlite3-*
