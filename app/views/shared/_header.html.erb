<header class="site-header" data-controller="navigation">
  <div class="header-inner">
    <a href="/" class="brand-link" onclick="if(window.showView){showView('home'); return false;}" aria-label="NoUploadPDF Home">
      <svg width="28" height="28" viewBox="0 0 48 48" aria-hidden="true" style="flex-shrink:0;">
        <rect x="0" y="0" width="48" height="48" rx="12" fill="var(--logo-tile)"/>
        <path d="M12 9h14l7 7v23H12z" fill="var(--logo-paper)"/>
        <path d="M26 9v7h7z" fill="var(--logo-green)"/>
        <rect x="24" y="24" width="18" height="18" rx="4.5" fill="var(--logo-tile)"/>
        <path d="M29.5 31v-2.5a3.5 3.5 0 0 1 7 0V31" stroke="var(--logo-green)" stroke-width="2.6" stroke-linecap="round" fill="none"/>
        <rect x="26.5" y="30.5" width="13" height="9" rx="2.2" fill="var(--logo-green)"/>
        <circle cx="33" cy="35" r="1.5" fill="var(--logo-tile)"/>
      </svg>
      <span>NoUpload<span style="color:var(--tertiary);">PDF</span></span>
    </a>

    <nav class="nav-desktop" aria-label="Primary navigation">
      <button class="nav-btn" onclick="if(window.scrollToToolsCatalog){scrollToToolsCatalog();}else{window.location.href='/#chooseToolSection';}">Tools (28)</button>
      <a class="nav-btn" href="/scanner" onclick="if(window.openScanner){return openScanner(event);}" style="color:var(--accent-text);text-decoration:none;">
        <span style="display:inline-block; width:7px; height:7px; border-radius:50%; background:var(--accent-light); margin-right:6px;"></span>
        <span>Phone → Studio Scanner</span>
      </a>
      <button class="nav-btn" onclick="if(window.scrollToTerminal){scrollToTerminal();}else{window.location.href='/#securityTerminalSection';}">Security Terminal</button>
      <button class="nav-btn" onclick="if(window.showView){showView('macapp');}else{window.location.href='/mac-pro';}">Open Source &amp; Support</button>
      <button class="nav-btn" onclick="if(window.showView){showView('about');}else{window.location.href='/about';}">FAQ</button>
    </nav>

    <div style="display:flex; align-items:center; gap:10px;">
      <button class="nav-btn header-pill-desktop" onclick="if(window.openCmdPalette) openCmdPalette()" style="font-family:var(--font-mono); font-size:12px; background:var(--surface-sunk); color:var(--on-surface-muted); border:1px solid var(--outline); border-radius:999px; padding:0 12px; height:32px; gap:8px;" title="Search all 28 tools (⌘K)">
        <span>Search</span>
        <kbd style="font-size:10px; opacity:0.85; background:var(--surface); border:1px solid var(--outline); border-radius:4px; padding:1px 5px;">⌘K</kbd>
      </button>
      <div class="privacy-pill header-pill-desktop" title="Enforced by Rails NoUploadGuardMiddleware &amp; CSP">
        <span class="privacy-dot"></span>
        <span id="headerBytesCounter">0 bytes stored</span>
      </div>
    </div>
  </div>
</header>
