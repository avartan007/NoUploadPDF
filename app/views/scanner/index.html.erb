<% content_for :title, "Phone Camera Scanner (WebRTC P2P + Direct Capture) · NoUploadPDF" %>

<div
  class="container"
  style="padding: 36px 0 72px;"
  data-controller="scanner-mac"
  data-scanner-mac-room-value="<%= @room_code %>"
  data-scanner-mac-phone-url-value="<%= @phone_url %>"
>
  <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:20px;">
    <div>
      <div class="eyebrow" style="color:var(--brand);margin-bottom:6px;">WebRTC Peer-to-Peer Scanner</div>
      <h1 class="headline-md">Scan with your phone. Edit live in the Studio.</h1>
      <p style="font-size:13.5px;color:var(--muted);margin-top:4px;">
        Photos go peer-to-peer; a signaling relay sees only the connection handshake. Or use <strong>Direct Camera / Photo Upload</strong> below on any connection.
      </p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <button type="button" class="btn btn-primary" data-action="scanner-mac#openDirectCapture">Direct Camera / Photo Upload</button>
      <a href="/" class="btn btn-secondary">Back to Studio</a>
    </div>
  </div>

  <!-- Hidden <input type="file" capture="environment"> fallback that works on ANY connection -->
  <input
    type="file"
    accept="image/*"
    capture="environment"
    multiple
    data-scanner-mac-target="directInput"
    data-action="change->scanner-mac#handleDirectFiles"
    style="display:none;"
  >

  <!-- Prominent Live Connected Device Banner (Appears as soon as phone opens QR link) -->
  <div
    id="connectedPhoneBanner"
    style="display:none;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:14px 18px;margin-bottom:20px;background:#e1f8eb;border:1.5px solid #00875a;border-radius:12px;color:#00673f;"
    role="status"
    aria-live="polite"
  >
    <div style="display:flex;align-items:center;gap:10px;">
      <span style="width:10px;height:10px;border-radius:50%;background:#00875a;box-shadow:0 0 0 4px rgba(0,135,90,0.2);display:inline-block;"></span>
      <span style="font-size:14.5px;font-weight:600;">Phone Connected: <strong id="connectedPhoneName">iPhone</strong></span>
      <span style="font-size:13px;color:#0f5132;">— Photos transfer peer-to-peer into your browser memory.</span>
    </div>
    <span class="mono" id="connectedPhoneTransport" style="font-size:11.5px;background:#ffffff;padding:4px 10px;border-radius:999px;border:1px solid #86efac;">WebRTC P2P · Room <%= @room_code %></span>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:20px;align-items:start;">

    <!-- STEP 1: QR PAIRING + DIRECT CAPTURE FALLBACK -->
    <section style="background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:24px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:8px;">
        <div class="title-md">Step 1 · Scan QR or Capture Directly</div>
        <span class="mono" data-scanner-mac-target="p2pBadge" style="font-size:11px;color:var(--brand);background:var(--brand-soft);border:1px solid var(--brand-border);padding:4px 9px;border-radius:6px;font-weight:600;">
          P2P ROOM: <%= @room_code %>
        </span>
      </div>

      <div style="display:flex;justify-content:center;padding:18px;background:#ffffff;border:1px solid var(--border);border-radius:12px;">
        <div
          data-scanner-mac-target="qr"
          role="img"
          aria-label="QR code for phone camera pairing"
          style="width:min(210px,64vw);height:min(210px,64vw);display:flex;align-items:center;justify-content:center;"
        ></div>
      </div>

      <div style="display:flex;gap:8px;margin-top:12px;">
        <input
          data-scanner-mac-target="urlText"
          class="field-input mono"
          readonly
          value="<%= @phone_url %>"
          style="flex:1;font-size:11.5px;background:var(--surface-sunk);"
          aria-label="Phone capture URL"
        >
        <button type="button" class="btn btn-secondary" data-action="scanner-mac#copyLink" style="padding:9px 14px;">Copy Link</button>
      </div>

      <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;">
        <button type="button" class="btn btn-secondary btn-tiny" data-action="scanner-mac#usePublicOriginUrl">Use Site Origin URL (HTTPS)</button>
        <button type="button" class="btn btn-secondary btn-tiny" data-action="scanner-mac#useLanUrl">Use Local Wi-Fi IP (<%= ScannerBridge.lan_ip %>)</button>
      </div>

      <!-- Universal fallback box (<input type="file" capture>) -->
      <div style="margin-top:14px;padding:12px;background:var(--surface-sunk);border:1px solid var(--border);border-radius:10px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;">
        <div style="font-size:12.5px;color:var(--ink);">
          <strong>On this device or restricted network?</strong><br>
          <span style="color:var(--muted);font-size:12px;">Use native camera capture or pick photos directly:</span>
        </div>
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
          <button type="button" class="btn btn-primary btn-tiny" data-action="scanner-mac#openDirectCapture">Camera / Pick Photos</button>
          <button type="button" class="btn btn-secondary btn-tiny" data-action="scanner-mac#addSimulatedScan">+ Test Scan</button>
        </div>
      </div>
    </section>

    <!-- STEP 2: STAGED PHOTOS -> OPEN IN STUDIO -->
    <section style="background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:24px;">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;">
        <div class="title-md">Step 2 · Scanned Photos (<span class="mono" data-scanner-mac-target="count">0</span>)</div>
        <div style="display:flex;align-items:center;gap:7px;background:var(--surface-sunk);padding:5px 10px;border-radius:999px;border:1px solid var(--border);">
          <span data-scanner-mac-target="statusDot" style="width:8px;height:8px;border-radius:50%;background:#f59e0b;display:inline-block;"></span>
          <span class="mono" data-scanner-mac-target="statusText" style="font-size:11.5px;color:var(--muted);">Waiting for phone…</span>
        </div>
      </div>

      <div
        data-scanner-mac-target="list"
        style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;max-height:320px;overflow-y:auto;margin-bottom:14px;"
      ></div>

      <div
        data-scanner-mac-target="empty"
        style="padding:32px 16px;text-align:center;border:1.5px dashed var(--border-strong);border-radius:12px;background:var(--surface-sunk);color:var(--muted);font-size:13.5px;margin-bottom:14px;"
      >
        No photos scanned yet.<br>Scan the QR code with your phone, click <strong>Camera / Pick Photos</strong>, or click <strong>+ Test Scan</strong>.
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;">
        <div>
          <label class="field-label" for="scannerStudioTool">Open in Studio Tool (All 28)</label>
          <select id="scannerStudioTool" class="field-select" data-scanner-mac-target="toolSelect">
            <option value="merge">01 · Merge &amp; Combine Pages (Default)</option>
            <option value="split">02 · Split PDF</option>
            <option value="extract">03 · Extract Pages</option>
            <option value="rotate">04 · Rotate Pages</option>
            <option value="organize">05 · Reorder &amp; Delete Pages</option>
            <option value="alternate">06 · Alternate &amp; Mix Pages</option>
            <option value="splitText">07 · Split by Text</option>
            <option value="splitBookmarks">08 · Split by Chapters</option>
            <option value="splitHalf">09 · Split Page in Half</option>
            <option value="splitSize">10 · Split by File Size</option>
            <option value="nup">11 · Multiple Pages per Sheet</option>
            <option value="imagesToPdf">13 · Images to PDF</option>
            <option value="pdfToImages">14 · PDF to Images (.zip)</option>
            <option value="pdfToDocx">15 · PDF to Word (.docx)</option>
            <option value="pdfToMarkdown">16 · PDF to Markdown (.md)</option>
            <option value="zip">17 · Bundle into ZIP</option>
            <option value="fillSign">18 · Sign PDF</option>
            <option value="redact">19 · Black Out Sensitive Text (Redact)</option>
            <option value="watermark">20 · Add Watermark</option>
            <option value="pageNumbers">21 · Add Page Numbers</option>
            <option value="crop">22 · Crop Page Margins</option>
            <option value="flip">23 · Flip &amp; Mirror Pages</option>
            <option value="compress">24 · Target-Size Compress (100KB / 200KB)</option>
            <option value="ocr">25 · Make Text Searchable (OCR)</option>
            <option value="password">26 · Password Protect / Unlock</option>
            <option value="metadata">27 · Clean Hidden File Info</option>
            <option value="workflow">28 · Multi-Step Batch Pass</option>
          </select>
        </div>
        <div>
          <label class="field-label" for="scannerPaper">Page Size</label>
          <select id="scannerPaper" class="field-select" data-scanner-mac-target="paper">
            <option value="A4">Standard A4 Pages</option>
            <option value="Letter">US Letter Pages</option>
            <option value="photos_only">Keep Individual Pages Separate</option>
          </select>
        </div>
      </div>

      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <button
          type="button"
          class="btn btn-success"
          style="flex:1;font-size:14.5px;padding:12px 18px;"
          data-action="scanner-mac#sendToStudio"
          data-scanner-mac-target="studioButton"
          disabled
        >Open Scanned Photos in Studio →</button>
        <button
          type="button"
          class="btn btn-secondary"
          data-action="scanner-mac#clearPages"
          data-scanner-mac-target="clearButton"
          disabled
        >Clear</button>
      </div>

      <p
        class="mono"
        data-scanner-mac-target="flash"
        aria-live="polite"
        style="margin-top:10px;font-size:12px;color:var(--brand);min-height:18px;font-weight:500;"
      ></p>
    </section>
  </div>
</div>
