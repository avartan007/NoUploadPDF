<% content_for :title, "PocketLens™ Phone Scanner (iPhone & Android) · NoUploadPDF" %>

<div
  class="phone-shell"
  data-controller="scanner-phone"
  data-scanner-phone-room-value="<%= @room_code %>"
>
  <header style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
    <div>
      <div class="eyebrow" style="margin-bottom:4px;color:#00875a;">NoUploadPDF · PocketLens™</div>
      <div class="title-md" style="font-size:20px;">Phone → Studio Scanner</div>
    </div>
    <span class="mono" style="font-size:11px;color:#00673f;background:#e1f8eb;border:1px solid #b7ebd0;padding:4px 9px;border-radius:6px;font-weight:500;">
      ROOM <%= @room_code.presence || "NONE" %>
    </span>
  </header>

  <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;background:var(--surface);border:1px solid var(--outline);border-radius:10px;padding:10px 12px;">
    <div style="display:flex;align-items:center;gap:8px;">
      <span data-scanner-phone-target="statusDot" style="width:9px;height:9px;border-radius:50%;background:var(--outline-strong);display:inline-block;"></span>
      <span class="mono" data-scanner-phone-target="status" style="font-size:11.5px;color:var(--on-surface);">Connecting to Desktop Studio…</span>
    </div>
    <span class="mono" data-scanner-phone-target="deviceBadge" style="font-size:10.5px;color:#2563eb;background:#eff6ff;padding:3px 7px;border-radius:999px;">iPhone / Android</span>
  </div>

  <% unless @valid_room %>
    <div class="phone-card" style="border-color:#e11d48;color:#be123c;background:#fff1f2;font-size:13.5px;">
      This pairing link is invalid. Re-scan the QR code shown on your desktop Studio screen.
    </div>
  <% end %>

  <div
    data-scanner-phone-target="banner"
    hidden
    style="background:#e1f8eb;color:#00673f;border:1px solid #56d298;border-radius:10px;padding:10px 12px;font-size:13px;font-weight:500;"
  ></div>

  <!-- Primary path: native iOS & Android camera or multi-photo picker (works over plain HTTP on Wi-Fi) -->
  <div class="phone-card" style="border-color:#00875a;">
    <div class="eyebrow" style="margin-bottom:10px;color:#00875a;">Step 1 · Capture or Pick Pages (iPhone &amp; Android)</div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
      <button
        type="button"
        class="btn btn-success"
        style="width:100%;height:54px;font-size:15px;background:#00875a;border-color:#00875a;"
        data-action="scanner-phone#openCamera"
        <%= "disabled" unless @valid_room %>
      >Take Photo</button>

      <button
        type="button"
        class="btn btn-secondary"
        style="width:100%;height:54px;font-size:14px;"
        data-action="scanner-phone#openGallery"
        <%= "disabled" unless @valid_room %>
      >Pick from Gallery</button>
    </div>

    <!-- Single camera capture input -->
    <input
      type="file"
      accept="image/*"
      capture="environment"
      data-scanner-phone-target="file"
      data-action="change->scanner-phone#fileChosen"
      style="display:none;"
    >

    <!-- Multi-photo gallery input for batch sending -->
    <input
      type="file"
      accept="image/*"
      multiple
      data-scanner-phone-target="gallery"
      data-action="change->scanner-phone#galleryChosen"
      style="display:none;"
    >

    <div style="margin-top:12px;">
      <label class="field-label" for="phoneFilter">Document Filter &amp; Glare Cleanup Preset</label>
      <select id="phoneFilter" class="field-select" data-scanner-phone-target="filter">
        <option value="auto">Auto-Flat (Shadow &amp; Glare Cleanup + Contrast)</option>
        <option value="bw">Crisp B&amp;W Document (Adaptive Threshold)</option>
        <option value="ink">High-Contrast Ink Boost</option>
        <option value="grayscale">Balanced Grayscale</option>
        <option value="color">Original Color Photo (As-Is)</option>
      </select>
    </div>

    <div style="margin-top:10px;display:flex;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--on-surface);">
      <label style="display:flex;align-items:center;gap:6px;"><input type="checkbox" checked> Auto Edge Detection</label>
      <label style="display:flex;align-items:center;gap:6px;"><input type="checkbox" checked> Shadow &amp; Glare Removal</label>
      <label style="display:flex;align-items:center;gap:6px;"><input type="checkbox" checked> Multi-Page Auto-Capture</label>
    </div>

    <p class="phone-hint" style="margin-top:10px;" data-scanner-phone-target="hint">
      Works on both <strong>iPhone</strong> and <strong>Android</strong>. Every photo is sent straight into your desktop Studio workspace so you can run all 28 PDF tools on it.
    </p>
  </div>

  <!-- Perspective correction: drag four corners, then send to Studio -->
  <div class="phone-card" data-scanner-phone-target="adjustPanel" hidden>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px;">
      <div class="eyebrow" style="color:#2563eb;">Straighten or Send As-Is to Studio</div>
      <span class="mono" style="font-size:10.5px;color:var(--on-surface-muted);">drag 4 corners</span>
    </div>

    <canvas
      data-scanner-phone-target="adjustCanvas"
      data-action="pointerdown->scanner-phone#adjustPointerDown pointermove->scanner-phone#adjustPointerMove pointerup->scanner-phone#adjustPointerUp pointercancel->scanner-phone#adjustPointerUp"
      style="display:block;width:100%;height:auto;border-radius:8px;background:#111113;touch-action:none;cursor:crosshair;"
    ></canvas>

    <p class="phone-hint" style="margin-top:8px;">
      Drag the corner handles to straighten the page, or tap <strong>Send As-Is</strong> to beam the full photo directly into the Studio.
    </p>

    <div style="display:flex;gap:8px;margin-top:10px;">
      <button
        type="button"
        class="btn btn-success"
        style="flex:1;background:#00875a;border-color:#00875a;"
        data-action="scanner-phone#confirmAdjust"
      >Send Straightened →</button>
      <button
        type="button"
        class="btn btn-secondary"
        data-action="scanner-phone#skipAdjust"
      >Send As-Is →</button>
    </div>
  </div>

  <!-- Live viewfinder (HTTPS / localhost) -->
  <div class="phone-card">
    <div class="eyebrow" style="margin-bottom:10px;">Live Camera Viewfinder</div>

    <div class="phone-viewfinder">
      <video
        data-scanner-phone-target="video"
        autoplay
        muted
        playsinline
        hidden
        style="background:#111113;"
      ></video>
      <span class="mono" id="cameraPlaceholder" style="position:absolute;font-size:11px;color:#94a3b8;">live viewfinder standby</span>
    </div>

    <button
      type="button"
      class="btn btn-secondary"
      style="width:100%;margin-top:10px;"
      data-action="scanner-phone#toggleCamera"
      data-scanner-phone-target="liveButton"
      <%= "disabled" unless @valid_room %>
    >Start Live Camera</button>

    <button
      type="button"
      class="btn btn-primary"
      style="width:100%;margin-top:8px;background:#00875a;border-color:#00875a;"
      data-action="scanner-phone#shoot"
      data-scanner-phone-target="shutterButton"
      hidden
    >Snap &amp; Beam to Studio</button>
  </div>

  <!-- Session feedback -->
  <div class="phone-card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
      <div class="eyebrow">Beamed to Studio (<span class="mono" data-scanner-phone-target="sentCount">0</span>)</div>
      <button
        type="button"
        class="btn btn-secondary"
        style="padding:6px 10px;font-size:11px;"
        data-action="scanner-phone#sendSamplePage"
        data-scanner-phone-target="sampleButton"
      >+ Beam Test Page</button>
    </div>

    <div
      data-scanner-phone-target="empty"
      class="phone-hint"
    >Photos you capture appear here and inside your desktop Studio workspace immediately.</div>

    <div
      data-scanner-phone-target="previewList"
      style="display:flex;gap:8px;overflow-x:auto;padding:4px 0;"
    ></div>
  </div>

  <canvas data-scanner-phone-target="canvas" width="1" height="1" style="display:none;"></canvas>

  <p class="phone-hint" style="text-align:center;">
    100% Local Wi-Fi transfer · Zero cloud storage · Ready for all 28 Studio tools.
  </p>
</div>
