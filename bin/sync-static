#!/usr/bin/env ruby
# Regenerate the static landing page and all route/slug subpages from the Rails source of truth:
#   app/assets/stylesheets/application.css  -> public/styles.css
#   app/views/pages/home.html.erb body+engine -> public/index.html, index.html,
#                                                public/tools/index.html,
#                                                public/compare/index.html,
#                                                public/studio/index.html,
#                                                public/scanner/index.html,
#                                                public/about/index.html,
#                                                and all public/tools/*/index.html & guide subpages

require "fileutils"

ROOT = File.expand_path("..", __dir__)
ERB = File.join(ROOT, "app/views/pages/home.html.erb")
CSS = File.join(ROOT, "app/assets/stylesheets/application.css")
PUBLIC = File.join(ROOT, "public/index.html")
ROOT_INDEX = File.join(ROOT, "index.html")
PUBLIC_CSS = File.join(ROOT, "public/styles.css")

HEADER = "<!-- Ink-Bleed Theme Changer WebGL2 Canvas Overlay -->"
TITLE = "NoUploadPDF — Your PDFs never leave your device"

erb = File.read(ERB, encoding: "UTF-8")
start = erb.index(HEADER) or abort "header marker not found in #{ERB}"
finish = erb.rindex("</script>") or abort "engine script not found in #{ERB}"
finish += "</script>".length
segment = erb[start...finish]

File.write(PUBLIC_CSS, File.read(CSS, encoding: "UTF-8"), encoding: "UTF-8")
puts "wrote public/styles.css (#{File.size(PUBLIC_CSS)} bytes)"

html = File.read(PUBLIC, encoding: "UTF-8")
html.sub!(/<style>.*?<\/style>/m, '<link rel="stylesheet" href="/styles.css">')
html.sub!(/<title>.*?<\/title>/m, "<title>#{TITLE}</title>")

unless html.include?("three.min.js")
  html.sub!(
    '<script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>',
    "<script src=\"https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js\"></script>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js\"></script>"
  )
end

old_start = html.index(HEADER) or abort "header marker not found in #{PUBLIC}"
old_finish = html.rindex("</script>") or abort "engine script not found in #{PUBLIC}"
old_finish += "</script>".length
html = html[0...old_start] + segment + html[old_finish..]

File.write(PUBLIC, html, encoding: "UTF-8")
File.write(ROOT_INDEX, html, encoding: "UTF-8")
puts "wrote public/index.html and index.html (#{html.bytesize} bytes)"

# Sync top-level route directories (/tools, /compare, /studio, /scanner, /about, and guide slugs)
route_dirs = [
  "public/tools",
  "public/compare",
  "public/studio",
  "public/scanner",
  "public/about",
  "public/compress-pdf-to-200kb",
  "public/merge-pdf-for-visa",
  "public/redact-private-pdf"
]

route_dirs.each do |rel_dir|
  dir_path = File.join(ROOT, rel_dir)
  FileUtils.mkdir_p(dir_path)
  File.write(File.join(dir_path, "index.html"), html, encoding: "UTF-8")
end

# Sync all existing public/tools/<slug>/index.html subdirectories so no stale Nov 10 HTML remains anywhere
Dir.glob(File.join(ROOT, "public/tools/*/index.html")).each do |subpage|
  File.write(subpage, html, encoding: "UTF-8")
end

puts "synced #{route_dirs.size} route directories and #{Dir.glob(File.join(ROOT, 'public/tools/*/index.html')).size} tool subpages"
