#!/usr/bin/env bash
# Start the Rails server over HTTPS so the iPhone live viewfinder works.
#
#   bin/dev-https
#
# A self-signed certificate is generated on first run under tmp/certs and
# includes the current LAN IP in its subjectAltName. iOS will warn that the
# certificate is not trusted; open the URL once and accept it.

set -euo pipefail
cd "$(dirname "$0")/.."

PORT="${PORT:-3005}"
CERT_DIR="${CERT_DIR:-tmp/certs}"
KEY="$CERT_DIR/dev-key.pem"
CERT="$CERT_DIR/dev-cert.pem"

LAN_IP="$(ipconfig getifaddr en0 2>/dev/null || true)"
if [ -z "$LAN_IP" ]; then
  LAN_IP="$(ipconfig getifaddr en1 2>/dev/null || true)"
fi
if [ -z "$LAN_IP" ]; then
  LAN_IP="127.0.0.1"
fi

mkdir -p "$CERT_DIR"
if [ ! -f "$KEY" ] || [ ! -f "$CERT" ]; then
  echo "Generating self-signed certificate for localhost + ${LAN_IP}…"
  openssl req -x509 -newkey rsa:2048 -sha256 -days 365 -nodes \
    -keyout "$KEY" -out "$CERT" \
    -subj "/CN=NoUploadPDF Dev" \
    -addext "subjectAltName=DNS:localhost,IP:127.0.0.1,IP:${LAN_IP}" >/dev/null 2>&1
fi

export SSL_KEY="$KEY"
export SSL_CERT="$CERT"
export PORT

cat <<EOF
HTTPS scanner:  https://${LAN_IP}:${PORT}/scanner
Local scanner:  https://localhost:${PORT}/scanner

Accept the self-signed certificate once on the iPhone. The native "Take photo"
button still works over plain HTTP, so HTTPS is only needed for the live viewfinder.
EOF

exec bundle exec puma -C "$PWD/config/puma_https.rb" "$PWD/config.ru"
