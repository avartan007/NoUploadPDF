# Force GitHub Linguist to report this repository as JavaScript / Next.js / React + CSS
# and ignore generated static HTML mirrors and the archived RoR zip backup.

index.html linguist-generated=true
public/** linguist-generated=true
vendor/** linguist-vendored=true
docs/** linguist-documentation=true
*.md linguist-documentation=true
*.zip binary linguist-generated=true

src/**/*.js linguist-language=JavaScript
src/**/*.jsx linguist-language=JavaScript
server/**/*.js linguist-language=JavaScript
scripts/**/*.mjs linguist-language=JavaScript
tests/**/*.mjs linguist-language=JavaScript
src/styles/**/*.css linguist-language=CSS
